#!/usr/bin/env python3
"""workflow-pruefen: prüft einen n8n-Workflow auf STILLE Fehler (für buildbar_ im Chat von one.intelligence). Gemeint ist,
was n8n ohne Meldung durchlässt und was später zu falschen Ergebnissen, offenen Türen oder Kosten führt. Der Befehl liest
nur und ändert nichts. Ruf ihn nach jeder Bau-Etappe und vor dem Abschluss auf.

  workflow-pruefen <workflow-id>      holt den Workflow über n8n-werkzeug (n8n_get_workflow) und prüft ihn
  workflow-pruefen --datei <pfad>     prüft eine Workflow-Datei (JSON), zum Beispiel workflows/<kurzname>.json
  workflow-pruefen hilfe              diese Hilfe mit der Liste der Prüfungen

Zwei Stufen: FEHLER behebst du, bevor du weiterbaust. HINWEISE klärst du spätestens vor dem Abschluss.
Rückgabewert: 0, sobald geprüft wurde (auch mit Befunden), 2 bei falschem Aufruf, 1 wenn der Workflow nicht zu holen war.
Parameterwerte, die wie Schlüssel aussehen, gibt der Befehl nie aus.
"""
import functools
import json
import os
import re
import sys
import time

PRUEFUNGEN = """Geprüft wird:
  FEHLER   Name ohne „buildbar: “ · Workflow mit Webhook nicht aktiv · gespeicherter Stand nicht der aktive · als ALT
           abgelegter Workflow noch aktiv
           offene Weiterleitung: Adresse, Pfad, Actor, Modell oder die ganze Anfrage eines bezahlten Dienstes kommt
           aus der Eingabe · HTTP Request oder RSS-Abruf auf eine Adresse aus der Eingabe · Zugangsdaten im Klartext,
           auch in Notizen, abgeschalteten Knoten und festgehaltenen Testdaten (pinData)
           Webhook: Pfad ohne Kürzel, „Respond to Webhook“ unbenutzt oder nicht erreichbar, ein Zweig endet ohne
           Antwort · Ausdruck {{ }} ohne „=“ am Anfang, $env · Set-Knoten im alten Format (liefert still {})
           Webhook-Daten ohne .body · Feld, das der Schritt davor nicht liefert · Verweis $('…') auf einen Knoten,
           den es nicht gibt · Baustein ohne mode "each" oder mit falscher source · IF mit beiden Ausgängen am
           selben Ziel · Switch-Verbindung an einem Ausgang, den es nicht gibt · Code-Knoten in Python oder mit
           fetch, $helpers.httpRequest, new URL(, $env, require(, {{ }} · KI: Sprachmodell ohne Zugang, Kette ohne
           Sprachmodell, Modell über „main“ verbunden, Parser und hasOutputParser passen nicht zusammen
           Knoten ohne Zugang (Google Sheets, Mail, HTTP Request mit Anmeldung und andere) · gleicher Name bei HTTP,
           Code, KI oder Baustein · Prüfung unvollständig (dann prüfst du von Hand)
  HINWEIS  Herkunft nicht prüfbar: Host einer Adresse, Pfad, Actor, Modell oder Anfrage eines bezahlten Dienstes
           steht nicht fest, und woher er kommt, lässt sich nicht verfolgen · bezahlter Baustein oder KI hinter
           öffentlichem Webhook ohne Tageszähler · Webhook ohne CORS, mit responseMode "onReceived" oder "lastNode",
           Test-Webhook · IF oder Switch mit leerem Ausgang oder allen Zielen am ersten Ausgang (fehlendes branch
           oder case) · Daten holen ohne alwaysOutputData · Tabelle lesen ohne returnAll (höchstens 50 Zeilen)
           Prompt verlangt Rechnen · Knoten ohne Vorgänger · keine Notiz · doppelte Namen, Standardnamen
Nicht prüfbar ist, ob das Ergebnis inhaltlich stimmt. Das zeigt nur der Test mit einem echten Beispiel."""

