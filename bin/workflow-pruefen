# Feldnamen von Zugängen, nach Entfernen von Bindestrichen und Unterstrichen: x-rapidapi-key, Ocp-Apim-Subscription-Key, appid
SCHLUESSEL_ENDE = ('apikey', 'accesskey', 'secretkey', 'privatekey', 'appkey', 'subscriptionkey', 'licensekey', 'authkey',
