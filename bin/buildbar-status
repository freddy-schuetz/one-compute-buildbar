#!/usr/bin/env bash
# buildbar-status: zeigt dem Assistenten, was eingerichtet ist und was fehlt.
# Gibt nie Schlüssel aus, nur ob sie da sind und ob sie funktionieren. Schlüssel gehen über die Standardeingabe an curl,
# nicht über die Befehlszeile (die sieht jede Prozessliste). Beendet sich immer mit 0.
. /opt/buildbar/schluessel-laden.sh
N8N="${N8N_API_URL:-https://n8n.oi.destination.one}"
N8N="${N8N%/}"
HUB="${OIL_HUB_URL:-https://oi-labor-hub.friedemann-schuetz.eu}"
HUB="${HUB%/}"
fehlt=()

n8n_anfrage() {  # $1 Pfad, weitere Argumente gehen an curl
  local pfad="$1"; shift
  printf 'header = "X-N8N-API-KEY: %s"\n' "$N8N_API_KEY" | curl -K - -s -m 20 "$@" "$N8N$pfad"
}
hub_anfrage() {  # $1 Pfad, weitere Argumente gehen an curl
  local pfad="$1"; shift
  printf 'header = "Authorization: Bearer %s"\n' "$OIL_HUB_TOKEN" | curl -K - -s -m 20 \
    -H "X-Kuerzel: ${KUERZEL:-}" -H "X-Person-Id: ${PERSON_ID:-}" "$@" "$HUB$pfad"
}

# Einen n8n-Schlüssel in den Chat einfügen ist nur sicher, wenn der Zusatz „buildbar Zugang“ in one.intelligence aktiv
# ist: Er fängt den Schlüssel ab, bevor das Modell ihn sieht, und schreibt beim Ablegen ZUSATZ=1 in die Zugangsdatei.
# ZUSATZ=1 bleibt aber in der Datei stehen, auch wenn der Zusatz später abgeschaltet wird. Solange er läuft, schreibt er
# die Datei bei einer Nachricht neu, sobald sie älter als 10 Minuten ist. Der Zusatz gilt deshalb nur als aktiv, wenn
# die Datei in den letzten 30 Minuten geschrieben wurde. Das nutzt unten der Abschnitt „ES FEHLT“.
# Die 10 Minuten stehen im Zusatz (MERKER_DAUER = 600 Sekunden) und müssen unter den 30 Minuten hier bleiben. Sonst
# gilt der Zusatz bei allen als nicht aktiv, und niemand bekommt mehr die Anleitung zum Einfügen.
zusatz_aktiv=''
if [ -n "${ZUSATZ:-}" ] && [ -n "$(find "$HOME/.buildbar/zugang.env" -mmin -30 2>/dev/null)" ]; then
  zusatz_aktiv=1
fi

echo "buildbar-Arbeitsplatz"
echo "Werkzeuge: node $(node --version 2>/dev/null || echo fehlt), n8n-mcp $(command -v n8n-mcp >/dev/null && echo da || echo fehlt), chromium $([ -x /usr/bin/chromium ] && echo da || echo fehlt), seite-pruefen $([ -f /opt/buildbar/seite-pruefen.js ] && echo da || echo fehlt)"
echo "Speicher im Home: $(df -h "$HOME" 2>/dev/null | awk 'NR==2 {print $4 " frei von " $2}')"

if [ -n "${KUERZEL:-}" ]; then
  echo "Kürzel: $KUERZEL"
elif [ ! -f "$HOME/.buildbar/zugang.env" ]; then
  echo "Kürzel: fehlt (die Zugangsdatei ist noch nicht da)"
  fehlt+=("DATEI")
else
  echo "Kürzel: fehlt"
  fehlt+=("ZUSATZ")
fi

if [ -n "${N8N_API_KEY:-}" ]; then
  code=$(n8n_anfrage "/api/v1/workflows?limit=1" -o /dev/null -w '%{http_code}')
  case "$code" in
    200) echo "n8n: verbunden ($N8N)"
         # Ein Admin-Schlüssel sieht alle Konten der n8n (die Nutzerliste geht nur für Admins)
         ucode=$(n8n_anfrage "/api/v1/users?limit=1" -o /dev/null -w '%{http_code}')
         [ "$ucode" = "200" ] && echo "n8n: ACHTUNG, der Schlüssel gehört einem Admin-Konto und sieht alle Konten dieser n8n. Nur für Tests der Betreuung; du arbeitest trotzdem nur mit Workflows, die mit „buildbar: “ beginnen."
         ;;
    401|403) echo "n8n: Schlüssel wird abgelehnt (HTTP $code)."; fehlt+=("N8N_API_KEY") ;;
    # Zeitüberschreitung (000), 5xx, 404, Umleitung: eine Störung, dann darf unten nicht „ALLES BEREIT.“ stehen
    *) echo "n8n: nicht erreichbar (HTTP $code)"; fehlt+=("STOERUNG") ;;
  esac
else
  echo "n8n: Schlüssel fehlt"
  # Fehlt die ganze Zugangsdatei (Eintrag DATEI), kommt zuerst nur die Bitte, die Nachricht noch einmal zu schicken.
  # Sonst gehört der fehlende Schlüssel immer unter „ES FEHLT“, auch bei der alten Einrichtung nur mit geheim.env:
  # Ohne den Eintrag stünde unten „ALLES BEREIT.“, obwohl der Schlüssel fehlt.
  [[ " ${fehlt[*]} " != *" DATEI "* ]] && fehlt+=("N8N_API_KEY")
fi

# Zugänge im n8n-Konto: Ein n8n-Schlüssel kann sie nicht auflisten (kein Recht dafür). buildbar-merken merkt sich die,
# die die Person einmal in einem Node ausgewählt hat.
if [ -x /usr/local/bin/buildbar-merken ]; then
  buildbar-merken liste 2>/dev/null
  echo "  (Neue Zugänge: Node ohne Zugang bauen, die Person wählt ihren Zugang dort einmal aus, dann buildbar-merken aus-workflow <workflow-id>.)"
fi

if [ -n "${OIL_HUB_TOKEN:-}" ]; then
  code=$(hub_anfrage "/person" -o /dev/null -w '%{http_code}')
  case "$code" in
    200) echo "Veröffentlichen: verbunden ($HUB)" ;;
    # Der Dienst lehnt das Zugangszeichen ab: Das liegt an der Einrichtung (Kurs-Geheimnis, Kürzel), nicht am Zusatz
    401|403) echo "Veröffentlichen: Zugang wird abgelehnt (HTTP $code)."; fehlt+=("HUB") ;;
    *) echo "Veröffentlichen: Dienst nicht erreichbar (HTTP $code)"; fehlt+=("STOERUNG") ;;
  esac
elif [[ " ${fehlt[*]} " != *" DATEI "* ]]; then
  echo "Veröffentlichen: Zugang fehlt"
  # Läuft der Zusatz und das Zugangszeichen fehlt trotzdem, stimmt seine Einrichtung nicht (Kurs-Geheimnis leer)
  if [ -n "$zusatz_aktiv" ]; then fehlt+=("HUB"); else fehlt+=("ZUSATZ"); fi
fi

if [ ${#fehlt[@]} -gt 0 ]; then
  echo
  echo "ES FEHLT:"
  printf '%s\n' "${fehlt[@]}" | sort -u | while read -r k; do
    case "$k" in
      DATEI) echo "  Die Zugangsdatei ist noch nicht da. Das passiert, wenn das Terminal gerade erst gestartet ist: Bitte die Person, ihre Nachricht einfach noch einmal zu schicken. Kommt das beim zweiten Mal wieder: Der Zusatz „buildbar Zugang“ ist nicht aktiv, Betreuung fragen." ;;
      HUB) echo "  Der Zugang zum Veröffentlichen passt nicht. Das liegt nicht an dir. Bitte die Betreuung fragen." ;;
      N8N_API_KEY)
        if [ -n "$zusatz_aktiv" ]; then
          echo "  n8n-Schlüssel: Die Person öffnet diese Seite: $N8N/settings/api (als anklickbaren Link weitergeben; von Hand: in n8n unten links auf den eigenen Namen, dann „Settings“ (Einstellungen), „n8n API“). Dort „Create an API key“ (Schlüssel erstellen): einen Namen eintragen, bei „Expiration“ (Gültigkeit) die längste Dauer wählen, am besten „No Expiration“, sonst läuft der Schlüssel nach 30 Tagen ab, und alle Rechte anhaken, falls danach gefragt wird. Den Schlüssel kopieren (er wird nur einmal angezeigt) und hier in den Chat einfügen. Der Zusatz „buildbar Zugang“ fängt ihn ab und speichert ihn, du bekommst ihn nicht zu sehen. Danach buildbar-status erneut aufrufen."
        else
          echo "  n8n-Schlüssel: Bitte die Betreuung fragen. Die Person fügt keinen Schlüssel in den Chat ein, solange der Zusatz „buildbar Zugang“ nicht aktiv ist."
        fi ;;
      STOERUNG) echo "  Ein Dienst antwortet gerade nicht (siehe oben). Das liegt nicht an der Person. In ein paar Minuten buildbar-status erneut aufrufen; bleibt es so, Betreuung fragen." ;;
      ZUSATZ) echo "  Kürzel und Zugang zum Veröffentlichen fehlen: Der Zusatz „buildbar Zugang“ ist in one.intelligence nicht aktiv. Bitte die Betreuung fragen." ;;
    esac
  done
else
  echo
  echo "ALLES BEREIT."
fi
exit 0
